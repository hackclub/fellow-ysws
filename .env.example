# Postgres (docker compose: `npm run db:up`)
DATABASE_URL=postgres://fellows:fellows@localhost:5442/fellows
# Public base URL, used to build OAuth redirect URIs
APP_URL=http://localhost:3000

# Hack Club Auth (https://auth.hackclub.com/developer/apps)
# Redirect URI: ${APP_URL}/auth/hackclub/callback  Scopes: openid profile email slack_id
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=

# Hackatime (https://hackatime.hackclub.com/oauth/applications)
# Redirect URI: ${APP_URL}/auth/hackatime/callback  Scopes: profile read  Confidential: yes
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Generate with `npm run keys:generate`. Back these up offline: losing them loses all PII.
ENCRYPTION_KEYS='{"1":"<base64 32 bytes>"}'
ENCRYPTION_ACTIVE_KEY_VERSION=1
# NEVER rotate LOOKUP_KEY: user lookups and the one-aid-attempt rule depend on it.
LOOKUP_KEY=

# Comma-separated Hack Club user ids (OIDC `sub`, e.g. ident!abc123)
ADMIN_HACKCLUB_IDS=

# Optional: extra Hack Club Auth scopes, e.g. "birthdate address" (only if the app is approved for them)
HACKCLUB_AUTH_EXTRA_SCOPES=
# Optional: Airtable sync of finished project reviews (docs/airtable.md)
AIRTABLE_PAT=
AIRTABLE_APP_NAME=
AIRTABLE_TABLE_NAME=
